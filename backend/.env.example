# Copy this file to .env and fill in real values. Never commit .env itself.

# Groq API key (console.groq.com) — used for vision + text model calls
GROQ_API_KEY=

# MySQL connection (schema.sql creates a database named cathodevision-ai)
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=cathodevision-ai

# Random secret used to sign JWT auth tokens — any long random string
JWT_SECRET=

# Comma-separated list of origins allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Hosted MySQL (leave DB_PORT/DB_SSL unset for local MySQL)
DB_PORT=3306
# DB_SSL=true            # verify TLS with the system CA bundle (TiDB Cloud, Aiven)
# DB_SSL_CA=             # or a path to a CA file instead
