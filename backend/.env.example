# Copy this file to .env and fill in real values. Never commit .env itself.

# Groq API key (console.groq.com) — used for vision + text model calls
GROQ_API_KEY=

# MySQL connection (schema.sql creates a database named cathodevision-ai)
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=cathodevision-ai

# Random secret used to sign JWT auth tokens — any long random string
JWT_SECRET=

# Comma-separated list of origins allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:5173
